@model UserSessionsModel;

<button type="button" class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Open sidebar">
	<span></span>
	<span></span>
	<span></span>
</button>

<div id="sidebar" class="sidebar open">
	<div class="sidebar-header">
		<span class="sidebar-title">Sessions</span>
		<button type="button" class="close-btn" onclick="toggleSidebar()" aria-label="Close sidebar"> &times; </button>
	</div>
	<div class="sidebar-content">
		<button type="button" class="new-session-button" onclick="startNewSession()">
			<span class="new-session-icon">+</span>
			<span>New Session</span>
		</button>
		@foreach (var item in Model.UserSessions)
		{
			<a class="sidebar-item @(item.Id == Model.CurrentSessionId ? "active" : "")"
			   data-session-id="@item.Id"
			   href="@Url.Action("Index", "Home", new { sessionId = item.Id })">
				@item.Title
			</a>
		}
	</div>
</div>