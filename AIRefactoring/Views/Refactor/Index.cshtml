@model RefactorModel;

<link rel="stylesheet" href="~/css/Refactor/index.css" asp-append-version="true" />

@if (Model.UserSession != null)
{
	@Html.HiddenFor(x => x.UserSession!.Id)
}

<div class="d-flex">
	<div id="sessions-container"></div>

	<div id="main-container" class="d-flex flex-column">
		<div class="white-blueprint">
			<div class="refactor-header" style="@(Model.UserSession == null ? "" : "display: none;")">
				<h2 class="title">AI Refactoring</h2>
				<p class="subtitle">Ask a question, paste your code, or describe what you'd like to improve.</p>
			</div>

			<div class="conversation" id="conversation">
				@if (Model.UserSession != null)
				{
					foreach (var codeArtifact in Model.UserSession.CodeArtifacts)
					{
						<div class="message-group">
							<div class="message user-message">
								<div class="message-header">
									<span class="message-label">You</span>
									<span class="message-date">@codeArtifact.CreatedAt.ToLocalTime()</span>
								</div>
								<div class="message-content">@codeArtifact.OriginalCode</div>
							</div>

							<div class="message ai-message">
								<div class="message-header">
									<span class="message-label">AI Refactoring</span>
								</div>
								<pre class="message-content code-response">@Html.Raw(codeArtifact.RefactoredCode)</pre>
							</div>
						</div>
					}
				}
			</div>

			<div class="refactor-input">
				<textarea id="code-input" class="code-input" placeholder="Describe what you'd like to refactor..." spellcheck="false"></textarea>

				<div class="input-footer">
					<button type="button" id="refactor-button" class="refactor-button">Refactor</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script src="~/js/Refactor/index.js" asp-append-version="true"></script>